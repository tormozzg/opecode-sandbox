#!/bin/bash
set -euo pipefail

# Stateful opencode sandbox runner: keeps the container around between
# sessions so files written inside the container (outside mounted dirs)
# are preserved.

# The image is required as the first argument (no hardcoded default).
# All remaining arguments are forwarded verbatim to opencode inside the
# container; omit them to run the opencode TUI. The reserved word
# "wipe-data" as the first argument after the image removes the project
# container instead.
if [[ $# -lt 1 ]]; then
	echo "Usage: $(basename "$0") <image-name> [opencode-args...]" >&2
	echo "  <image-name>    docker image to run, e.g. the one built by build-image.sh" >&2
	echo "  opencode-args   forwarded verbatim to 'opencode' inside the container;" >&2
	echo "                  omit them to run the opencode TUI, or use 'wipe-data'" >&2
	echo "                  to remove the project container" >&2
	exit 1
fi

if [[ "$1" == "wipe-data" ]]; then
	echo "Error: image name is required as the first argument." >&2
	echo "Usage: $(basename "$0") <image-name> [opencode-args...]" >&2
	exit 1
fi

IMAGE="$1"
shift

# Container name derived from the current project directory.
PROJECT_NAME="$(basename "$PWD")"
CONTAINER="oc-sand-${PROJECT_NAME}"

# Remove the project container so the next run creates a fresh one.
if [[ "${1:-}" == "wipe-data" ]]; then
	if [[ $# -gt 1 ]]; then
		echo "Error: 'wipe-data' takes no additional arguments." >&2
		exit 1
	fi
	if [[ -n "$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || true)" ]]; then
		echo "Removing container '$CONTAINER' (wipe-data)..."
		docker rm -f "$CONTAINER"
		echo "Container '$CONTAINER' removed; the next run creates a fresh one."
	else
		echo "No container '$CONTAINER' exists; nothing to wipe."
	fi
	exit 0
fi

# Shared docker flags (same mounts/env as the previous ephemeral runner).
DOCKER_FLAGS=(
	-v ./:/workspace
	-v ~/opencode/sandbox/data:/home/opencode/.local/share/opencode
	-v ~/opencode/sandbox/state:/home/opencode/.local/state/opencode
	-v ~/opencode/sandbox/config:/home/opencode/.config/opencode
	-v ~/opencode/sandbox/cache:/home/opencode/.cache/opencode
	-v ~/opencode/sandbox/omo:/home/opencode/.omo
	-v ~/opencode/sandbox/gradle:/home/opencode/.gradle
	--group-add 959
	-v /var/run/docker.sock:/var/run/docker.sock
	-w /workspace
	-e OPENCODE_EXPERIMENTAL_PLAN_MODE=1
	--add-host=host.docker.internal:host-gateway
)

# Optional extra docker flags from the environment (e.g. set by wrapper
# scripts): split on whitespace into an array, no eval involved.
EXTRA_FLAGS=()
if [[ -n "${OC_SAND_EXTRA_FLAGS:-}" ]]; then
	read -r -a EXTRA_FLAGS <<< "$OC_SAND_EXTRA_FLAGS"
fi

# Ensure the container exists and is running, without attaching to it.
# Shared by the opencode-argument modes, which exec a command into the
# container afterwards. Leaves the container running.
ensure_container_running() {
	local state
	state="$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || true)"
	case "$state" in
		running)
			echo "Container '$CONTAINER' is already running."
			;;
		exited|created)
			echo "Starting existing container '$CONTAINER'..."
			docker start "$CONTAINER"
			;;
		"")
			echo "Creating new container '$CONTAINER' (image: $IMAGE) in the background for this session..."
			docker run --name "$CONTAINER" -d "${DOCKER_FLAGS[@]}" "${EXTRA_FLAGS[@]}" "$IMAGE" sleep infinity >/dev/null
			for _ in {1..15}; do
				state="$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || true)"
				if [[ "$state" == "running" ]]; then
					break
				fi
				sleep 0.2
			done
			if [[ "$state" != "running" ]]; then
				echo "Error: container '$CONTAINER' did not reach state 'running' after creation." >&2
				exit 1
			fi
			;;
		*)
			echo "Error: container '$CONTAINER' is in unexpected state '$state'." >&2
			exit 1
			;;
	esac
}

# Run opencode with the given arguments inside the container; the
# container is created/started first and stays running.
if [[ $# -gt 0 ]]; then
	ensure_container_running
	echo "Running 'opencode $*' inside container '$CONTAINER'..."
	exec docker exec -it "$CONTAINER" opencode "$@"
fi

STATE="$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || true)"

case "$STATE" in
	running)
		echo "Container '$CONTAINER' is already running; attaching a new opencode session."
		exec docker exec -it "$CONTAINER" opencode
		;;
	exited|created)
		echo "Starting existing container '$CONTAINER'..."
		exec docker start -ai "$CONTAINER"
		;;
	"")
		echo "Creating new container '$CONTAINER' (image: $IMAGE)..."
		# Extra flags only apply here: existing containers keep their fixed
		# configuration (docker start / docker exec cannot change it).
		exec docker run --name "$CONTAINER" -it "${DOCKER_FLAGS[@]}" "${EXTRA_FLAGS[@]}" "$IMAGE" opencode
		;;
	*)
		echo "Error: container '$CONTAINER' is in unexpected state '$STATE'." >&2
		exit 1
		;;
esac
